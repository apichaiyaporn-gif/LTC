          <div id="ltcMap" class="w-full" style="height: 440px;"></div>
        </div>

        <div class="bento-card flex flex-col justify-between p-4 space-y-4">
          <div>
            <h3 class="font-heading text-base font-bold text-slate-900 flex items-center gap-2">
              <i data-lucide="shield-alert" class="h-4 w-4 text-rose-600"></i>
