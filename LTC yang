    function getFilteredPatients() {
      const q = document.getElementById('searchInput').value.trim().toLowerCase();
      const moo = document.getElementById('filterMoo').value;
      const status = document.getElementById('filterStatus').value;
      const cg = document.getElementById('filterCg').value;
      const doneFilter = document.getElementById('filterDone').value;

      return PATIENTS.filter(p => {
        const assigned = getAssignedCgId(p);
        if (moo !== 'ALL' && String(p.moo) !== moo) return false;
        if (status !== 'ALL' && p.status !== status) return false;
        if (cg !== 'ALL' && assigned !== cg) return false;
        const isDone = !!appState.done[p.code];
        if (doneFilter === 'DONE' && !isDone) return false;
        if (doneFilter === 'PENDING' && isDone) return false;
        if (q) {
          const hay = `${p.code} ${p.name} ${p.cid} ${p.house_no} ม.${p.moo} ${p.village} ${p.disease}`.toLowerCase();
          if (!hay.includes(q)) return false;
        }
        return true;
      });
    }

