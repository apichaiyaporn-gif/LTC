    async function handleScanFileInput(files) {
      if (!files || !files.length) return;
      for (const file of Array.from(files)) {
        if (!file.type.startsWith('image/')) continue;
        const reader = new FileReader();
        await new Promise(res => {
          reader.onload = e => {
            const img = new Image();
            img.onload = () => {
              let w = img.width, h = img.height, maxD = 1600;
              if (w > maxD || h > maxD) { if (w > h) { h = Math.round(h * maxD / w); w = maxD; } else { w = Math.round(w * maxD / h); h = maxD; } }
              const c = document.createElement('canvas'); c.width = w; c.height = h;
              c.getContext('2d').drawImage(img, 0, 0, w, h);
              const dataUrl = c.toDataURL('image/jpeg', 0.86);
              capturedImages.push({ id: 'img_' + Date.now() + Math.random().toString(36).slice(2, 6), dataUrl, base64: dataUrl.split(',')[1], mimeType: 'image/jpeg' });
              res();
            };
            img.src = e.target.result;
          };
          reader.readAsDataURL(file);
        });
      }
      renderScanImagePreviews();
      showToast(`เพิ่มภาพเอกสารแล้ว (รวม ${capturedImages.length} หน้า)`);
    }

    function renderScanImagePreviews() {
      const box = document.getElementById('imagePreviewContainer');
      const grid = document.getElementById('imageGrid');
      document.getElementById('imageCountText').textContent = String(capturedImages.length);
      if (!capturedImages.length) { box.classList.add('hidden'); grid.innerHTML = ''; return; }
      box.classList.remove('hidden');
      grid.innerHTML = capturedImages.map((img, i) => `
        <div class="relative aspect-[3/4] overflow-hidden rounded-2xl border border-slate-200 bg-slate-50 shadow-sm">
          <img src="${img.dataUrl}" data-lightbox-id="${img.id}" data-lightbox-page="${i + 1}" class="h-full w-full cursor-pointer object-cover" />
          <span class="absolute left-2 top-2 rounded-md bg-slate-900 px-2 py-0.5 text-[11px] font-bold text-white">หน้า ${i + 1}</span>
          <button type="button" data-remove-img="${img.id}" class="absolute right-2 top-2 h-6 w-6 rounded-lg bg-red-600 text-xs font-bold text-white">&times;</button>
        </div>
      `).join('');
    }

    async function startScanCamera() {
      if (cameraStream) { cameraStream.getTracks().forEach(t => t.stop()); cameraStream = null; }
      document.getElementById('cameraErrorOverlay').classList.add('hidden');
      if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
        document.getElementById('cameraErrorText').textContent = 'เบราว์เซอร์ไม่รองรับ WebRTC กรุณาใช้ปุ่มกล้องมือถือหรือคลังภาพแทน';
        document.getElementById('cameraErrorOverlay').classList.remove('hidden');
        return;
      }
      try {
        cameraStream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: { ideal: currentFacingMode } }, audio: false });
        document.getElementById('cameraVideo').srcObject = cameraStream;
      } catch (e) {
        document.getElementById('cameraErrorText').textContent = 'ไม่สามารถเข้าถึงกล้องได้ กรุณาอนุญาตสิทธิ์กล้อง';
        document.getElementById('cameraErrorOverlay').classList.remove('hidden');
      }
    }

    function closeScanCamera() {
      if (cameraStream) { cameraStream.getTracks().forEach(t => t.stop()); cameraStream = null; }
      document.getElementById('cameraModal').classList.add('hidden');
      document.getElementById('cameraModal').classList.remove('flex');
    }

    async function analyzeCapturedImagesWithAI() {
      if (!capturedImages.length) { showToast('กรุณาเพิ่มภาพอย่างน้อย 1 หน้า'); return; }
      const overlay = document.getElementById('loadingOverlay');
      const errBox = document.getElementById('apiErrorBox');
      errBox.classList.add('hidden');
      overlay.classList.remove('hidden');
      overlay.classList.add('flex');

      const prompt = 'คุณคือผู้เชี่ยวชาญ LTC อ่านแบบประเมิน Barthel ADL ภาษาไทยจากภาพทั้งหมดแล้วตอบเป็น JSON: prefix, fullName, age (int), houseNo, moo, subdistrict, diseases, adl (feeding,grooming,transfer,toilet,mobility,dressing,stairs,bathing,bowels,bladder), caregiverStatus, welfare, club, documentTotalScore (int), aiNotes';
      const parts = [{ text: prompt }, ...capturedImages.map(i => ({ inlineData: { mimeType: 'image/jpeg', data: i.base64 } }))];
      const payload = { contents: [{ role: 'user', parts }], generationConfig: { responseMimeType: 'application/json' } };

      try {
        const apiKey = '';
        const res = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key=${apiKey}`, {
          method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload)
        });
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const data = await res.json();
        const raw = JSON.parse(data?.candidates?.[0]?.content?.parts?.[0]?.text || '{}');
        const adl = {};
        BARTHEL_ITEMS.forEach(it => { adl[it.key] = Math.max(0, Math.min(it.max, parseInt(raw?.adl?.[it.key], 10) || 0)); });
        const total = calculateTotalAdl(adl);
        loadCaseIntoWorkspace({
          id: 'case_' + Date.now(), prefix: raw.prefix || '', fullName: raw.fullName || 'ไม่ระบุชื่อ', age: parseInt(raw.age, 10) || '',
          cid: '', healthRight: '', houseNo: raw.houseNo || '', moo: raw.moo || '', subdistrict: raw.subdistrict || '', gps: '',
          diseases: raw.diseases || '', caregiverStatus: raw.caregiverStatus || '', caregiverInfo: '', welfare: raw.welfare || '', club: raw.club || '',
          bladderMode: adl.bladder === 0 ? 'unconfirmed_incontinence' : 'normal', ltcGroup: total <= 4 ? 'group3' : (total <= 11 ? 'group1' : 'social'),
          adl, aiNotes: raw.aiNotes || ''
        });
        showToast('วิเคราะห์เอกสาร Barthel ADL สำเร็จ');
      } catch (err) {
        document.getElementById('apiErrorMessage').textContent = 'ไม่สามารถเชื่อมต่อ Gemini Vision AI ได้ในขณะนี้ (' + err.message + ')';
        errBox.classList.remove('hidden');
      } finally {
        overlay.classList.add('hidden');
        overlay.classList.remove('flex');
      }
    }

    function getScanHistory() { try { return JSON.parse(localStorage.getItem(SCAN_STORAGE_KEY) || '[]'); } catch (e) { return []; } }
    function updateScanHistoryBadge() { document.getElementById('historyBadge').textContent = String(getScanHistory().length); }
    function renderScanHistoryDrawer() {
      const list = getScanHistory();
      const el = document.getElementById('historyList');
      if (!list.length) { el.innerHTML = '<div class="py-10 text-center text-xs text-slate-500">ยังไม่มีประวัติเคสที่บันทึกไว้</div>'; return; }
      el.innerHTML = list.map(it => `
        <div class="rounded-2xl border border-slate-200 bg-white p-3 space-y-2">
          <div class="flex justify-between font-bold text-sm"><span>${escHtml((it.prefix ? it.prefix + ' ' : '') + it.fullName)}</span><span class="rounded bg-blue-100 px-2 py-0.5 text-xs text-blue-800">ADL ${it.totalScore}</span></div>
          <div class="flex gap-2">
            <button type="button" data-load-history="${it.id}" class="flex-1 rounded-xl bg-slate-900 py-1.5 text-xs font-bold text-white">เปิดดูเคส</button>
            <button type="button" data-del-history="${it.id}" class="rounded-xl bg-red-100 px-3 py-1.5 text-xs font-bold text-red-700">ลบ</button>
          </div>
        </div>
      `).join('');
    }

    // Wire Scanner events
    updateScanHistoryBadge();
    document.getElementById('inputMobileCamera').addEventListener('change', e => { handleScanFileInput(e.target.files); e.target.value = ''; });
    document.getElementById('inputGalleryFiles').addEventListener('change', e => { handleScanFileInput(e.target.files); e.target.value = ''; });
    document.getElementById('btnClearImages').addEventListener('click', () => { capturedImages = []; renderScanImagePreviews(); });
    document.getElementById('btnCloseApiError').addEventListener('click', () => document.getElementById('apiErrorBox').classList.add('hidden'));
    document.getElementById('btnOpenWebCamera').addEventListener('click', () => { const m = document.getElementById('cameraModal'); m.classList.remove('hidden'); m.classList.add('flex'); startScanCamera(); });
    document.getElementById('btnCloseCamera').addEventListener('click', closeScanCamera);
    document.getElementById('btnCloseCameraErr').addEventListener('click', closeScanCamera);
    document.getElementById('btnCameraDone').addEventListener('click', closeScanCamera);
    document.getElementById('btnSwitchCamera').addEventListener('click', () => { currentFacingMode = currentFacingMode === 'environment' ? 'user' : 'environment'; startScanCamera(); });
    document.getElementById('btnCapturePhoto').addEventListener('click', () => {
      const v = document.getElementById('cameraVideo');
      if (!v.videoWidth) return;
      const c = document.getElementById('cameraCanvas'); c.width = v.videoWidth; c.height = v.videoHeight;
      c.getContext('2d').drawImage(v, 0, 0);
      const dataUrl = c.toDataURL('image/jpeg', 0.86);
      capturedImages.push({ id: 'cam_' + Date.now(), dataUrl, base64: dataUrl.split(',')[1], mimeType: 'image/jpeg' });
      document.getElementById('cameraCapturedCount').textContent = String(capturedImages.length);
      renderScanImagePreviews();
    });
    document.getElementById('btnCloseLightbox').addEventListener('click', () => { document.getElementById('lightboxModal').classList.add('hidden'); document.getElementById('lightboxModal').classList.remove('flex'); });
    document.getElementById('btnAnalyzeAI').addEventListener('click', analyzeCapturedImagesWithAI);
    document.getElementById('btnLoadSample').addEventListener('click', () => { loadCaseIntoWorkspace(SAMPLE_CASE_DATA); showToast('โหลดข้อมูลตัวอย่าง นางปาน นันทพันธ์ แล้ว'); });
    document.getElementById('btnToggleEditor').addEventListener('click', () => document.getElementById('editorPanel').classList.toggle('hidden'));
    document.getElementById('btnCloseEditor').addEventListener('click', () => document.getElementById('editorPanel').classList.add('hidden'));
    document.getElementById('btnGetGps').addEventListener('click', () => {
      if (!navigator.geolocation) return;
      navigator.geolocation.getCurrentPosition(pos => {
        const coord = `${pos.coords.latitude.toFixed(6)}, ${pos.coords.longitude.toFixed(6)}`;
        document.getElementById('editGps').value = coord;
        if (currentScanData) { currentScanData.gps = coord; renderScannerResults(); }
        showToast('ดึงพิกัด GPS แล้ว');
      });
    });

    [['editPrefix','prefix'],['editFullName','fullName'],['editAge','age'],['editCid','cid'],['editHealthRight','healthRight'],['editHouseNo','houseNo'],['editMoo','moo'],['editSubdistrict','subdistrict'],['editGps','gps'],['editDiseases','diseases'],['editCaregiverStatus','caregiverStatus'],['editCaregiverInfo','caregiverInfo'],['editWelfare','welfare'],['editClub','club'],['editBladderMode','bladderMode'],['editLtcGroup','ltcGroup']].forEach(([id, prop]) => {
      const el = document.getElementById(id);
      el.addEventListener(el.tagName === 'SELECT' ? 'change' : 'input', e => {
        if (!currentScanData) return;
        currentScanData[prop] = prop === 'age' ? (parseInt(e.target.value, 10) || '') : e.target.value;
        renderScannerResults();
      });
    });

    document.querySelectorAll('.scan-tab-btn').forEach(b => b.addEventListener('click', () => {
      scanActiveTab = b.dataset.scanTab;
      document.querySelectorAll('.scan-tab-btn').forEach(x => {
        x.className = x.dataset.scanTab === scanActiveTab ? 'scan-tab-btn rounded-lg bg-slate-900 px-3 py-1.5 text-xs font-bold text-white' : 'scan-tab-btn rounded-lg px-3 py-1.5 text-xs font-bold text-slate-700';
      });
      applyScanTabVisibility();
    }));

    document.getElementById('btnSaveCase').addEventListener('click', () => {
      if (!currentScanData) return;
      const list = getScanHistory().filter(x => x.id !== currentScanData.id);
      list.unshift({ ...currentScanData, totalScore: calculateTotalAdl(currentScanData.adl), savedAt: new Date().toISOString() });
      try { localStorage.setItem(SCAN_STORAGE_KEY, JSON.stringify(list.slice(0, 50))); } catch (e) {}
      updateScanHistoryBadge();
      showToast('บันทึกประวัติเคสแล้ว');
    });

    document.getElementById('btnCopyFullReport').addEventListener('click', () => {
      if (!currentScanData) return;
      const total = calculateTotalAdl(currentScanData.adl);
      const sp = getSpecialPPInfo(total);
      copyText(`${currentScanData.prefix} ${currentScanData.fullName} | ADL ${total}/20 (${sp.code} ${sp.groupName})`, 'สรุปผล ADL');
    });

    document.getElementById('btnScannerExportCsv').addEventListener('click', () => {
      if (!currentScanData) return;
      const total = calculateTotalAdl(currentScanData.adl);
      const esc = v => `"${String(v ?? '').replace(/"/g, '""')}"`;
      const rows = [['ชื่อ-สกุล', `${currentScanData.prefix} ${currentScanData.fullName}`], ['คะแนนรวม ADL', total], ...BARTHEL_ITEMS.map(it => [it.en, currentScanData.adl[it.key]])];
      const csv = '\uFEFF' + rows.map(r => r.map(esc).join(',')).join('\r\n');
      const a = document.createElement('a'); a.href = URL.createObjectURL(new Blob([csv], { type: 'text/csv;charset=utf-8;' }));
      a.download = `3CPlus_ADL_${currentScanData.fullName || 'case'}.csv`; document.body.appendChild(a); a.click(); document.body.removeChild(a);
      showToast('ส่งออก CSV เคสนี้แล้ว');
    });

    document.getElementById('btnPrintA4').addEventListener('click', () => { scanActiveTab = 'all'; applyScanTabVisibility(); window.print(); });
    document.getElementById('btnOpenHistory').addEventListener('click', () => { renderScanHistoryDrawer(); const m = document.getElementById('historyModal'); m.classList.remove('hidden'); m.classList.add('flex'); });
    document.getElementById('btnCloseHistory').addEventListener('click', () => { document.getElementById('historyModal').classList.add('hidden'); document.getElementById('historyModal').classList.remove('flex'); });

    document.addEventListener('click', e => {
      const rm = e.target.closest('[data-remove-img]');
      if (rm) { capturedImages = capturedImages.filter(i => i.id !== rm.dataset.removeImg); renderScanImagePreviews(); return; }
      const lb = e.target.closest('[data-lightbox-id]');
      if (lb) {
        const found = capturedImages.find(i => i.id === lb.dataset.lightboxId);
        if (found) { document.getElementById('lightboxTitle').textContent = 'หน้าที่ ' + lb.dataset.lightboxPage; document.getElementById('lightboxImg').src = found.dataUrl; const m = document.getElementById('lightboxModal'); m.classList.remove('hidden'); m.classList.add('flex'); }
        return;
      }
      const adlBtn = e.target.closest('[data-adl-key]');
      if (adlBtn && currentScanData) {
        currentScanData.adl[adlBtn.dataset.adlKey] = parseInt(adlBtn.dataset.adlScore, 10);
        renderEditorAdlMatrix(); renderScannerResults(); return;
      }
      const lh = e.target.closest('[data-load-history]');
      if (lh) {
        const found = getScanHistory().find(x => x.id === lh.dataset.loadHistory);
        if (found) { loadCaseIntoWorkspace(found); document.getElementById('historyModal').classList.add('hidden'); document.getElementById('historyModal').classList.remove('flex'); }
        return;
      }
      const dh = e.target.closest('[data-del-history]');
      if (dh) {
        const list = getScanHistory().filter(x => x.id !== dh.dataset.delHistory);
        try { localStorage.setItem(SCAN_STORAGE_KEY, JSON.stringify(list)); } catch (e) {}
        updateScanHistoryBadge(); renderScanHistoryDrawer();
      }
    });
  </script>
</body>
</html>