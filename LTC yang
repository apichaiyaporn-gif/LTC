        : 'บริการนอกรายสัปดาห์: ปรับสภาพแวดล้อมบ้าน/ราวจับ/แสงสว่าง พาพบแพทย์ตามนัด และรับยาต่อเนื่อง';

      const cgAssign = isBed
        ? `มอบหมาย ${cgLabel} (Active) เยี่ยมดูแล 3–5 ครั้ง/สัปดาห์ (ระบุ ชม./นาที เข้มข้น) ร่วมกับญาติทุกวัน`
        : `มอบหมาย ${cgLabel} (Active) เยี่ยมดูแล ${p.adl <= 8 ? '2–3' : '1–2'} ครั้ง/สัปดาห์ (ระบุ ชม./นาที) ร่วมกับญาติ`;

      let caution = isBed
        ? 'ระวังแผลกดทับ การติดเชื้อทางเดินหายใจ/ขับถ่าย และขาดสารอาหาร; ประเมิน ADL/PPS/GDS หลังดูแลครบ 10–12 ด.'
        : 'ระวังพลัดตกหกล้มและภาวะสมองบกพร่อง/ทุพโภชนาการ; ประเมิน ADL หลังดูแลครบ 10–12 ด. เพื่อปิดเคส';
      if (isYoung && isBed) caution = 'กลุ่มอายุต่ำกว่า 60 ปีที่เป็นติดเตียง ' + caution;
      if (p.seq === 8 || p.seq === 9) caution = 'ครัวเรือนเดียวกับ บ.13 ม.2 ระวังสร้างข้อมูลบ้านซ้ำใน 3C+; ' + caution;
      if (p.seq === 31 || p.seq === 32) caution = 'ครัวเรือนเดียวกับ บ.111 ม.7 ระวังสร้างข้อมูลบ้านซ้ำใน 3C+; ' + caution;
      if (p.seq === 33 || p.seq === 34) caution = 'ครัวเรือนเดียวกับ บ.14 ม.7 ระวังสร้างข้อมูลบ้านซ้ำใน 3C+; ' + caution;

      const part1Summary = `[ประเมิน 4 ด้าน] ${assessments}
[ประเด็นปัญหา] ${problem}
[เป้าหมาย <3 ด.] ${shortGoal}
[งบ/กองทุน] ${policyFund}`;
      const part2Summary = `[แนวคิด] ${mindset}
[ทีมหมอครอบครัว] ${doctorTeam}
[ตาราง จ.-อา.] ${weekly}
[บริการนอกสัปดาห์] ${extraSvc}
[มอบหมาย CG] ${cgAssign}
[ติดตาม/ปิดเคส] ${caution}`;

      return {
        cgLabel, assessments, problem, shortGoal, policyFund,
        mindset, doctorTeam, weekly, extraSvc, cgAssign, caution,
        part1Summary, part2Summary
      };
    }

    function showToast(msg) {
      const toast = document.getElementById('toast');
      document.getElementById('toastText').textContent = msg;
      toast.classList.remove('hidden');
      toast.classList.add('flex');
      clearTimeout(window._toastTimer);
      window._toastTimer = setTimeout(() => {
        toast.classList.add('hidden');
        toast.classList.remove('flex');
      }, 2200);
    }

    function copyText(text, label = 'ข้อมูล') {
      const done = () => showToast(`คัดลอก ${label} แล้ว`);
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text).then(done).catch(() => fallbackCopy(text, done));
      } else {
        fallbackCopy(text, done);
      }
    }

    function fallbackCopy(text, cb) {
      const ta = document.createElement('textarea');
      ta.value = text;
      ta.style.position = 'fixed';
      ta.style.opacity = '0';
      document.body.appendChild(ta);
      ta.select();
      try { document.execCommand('copy'); } catch (e) {}
      document.body.removeChild(ta);
      cb();
    }

