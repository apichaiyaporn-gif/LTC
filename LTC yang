    <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-3 px-4 py-3 sm:px-6">
      <div class="flex items-center gap-3.5">
        <img src="https://i.ibb.co/1YK6mK7p/Icon-Split-Across-New-Pages.png" alt="3C Plus+ App Logo" class="h-12 w-12 rounded-2xl border border-white/30 bg-yellow-400 object-cover shadow-lg" />
        <div>
          <div class="flex items-center gap-2">
            <h1 class="font-heading text-lg font-bold tracking-tight text-white sm:text-xl">3C Plus+ Care Plan Studio</h1>
            <span class="rounded-full bg-yellow-400 px-2.5 py-0.5 text-[11px] font-bold text-slate-950 shadow-sm">Bento UI</span>
          </div>
          <p class="text-xs text-slate-300 sm:text-sm">รพ.สต.ยางสว่าง อ.รัตนบุรี จ.สุรินทร์ • ข้อมูล LTC (56 ราย) + CG (15 ราย) + AI ADL Scanner</p>
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-2">
        <button id="btnOpenHistory" type="button" class="cc-circle-btn inline-flex items-center gap-1.5 rounded-2xl bg-blue-600 px-3.5 py-2 text-xs font-semibold text-white hover:bg-blue-500 sm:text-sm">
          <i data-lucide="history" class="h-4 w-4"></i>
          <span>ประวัติสแกน</span>
          <span id="historyBadge" class="inline-flex h-5 min-w-[20px] items-center justify-center rounded-full bg-yellow-400 px-1.5 text-[11px] font-bold text-slate-950">0</span>
        </button>
        <button id="btnExportCsv" type="button" class="cc-circle-btn inline-flex items-center gap-1.5 rounded-2xl bg-yellow-400 px-3.5 py-2 text-xs font-bold text-slate-950 hover:bg-yellow-300 sm:text-sm">
          <i data-lucide="file-spreadsheet" class="h-4 w-4"></i>
          <span>ส่งออก CSV (Excel)</span>
        </button>
        <button id="btnResetState" type="button" class="cc-circle-btn inline-flex items-center gap-1.5 rounded-2xl bg-red-600 px-3 py-2 text-xs font-semibold text-white hover:bg-red-500 sm:text-sm">
          <i data-lucide="rotate-ccw" class="h-4 w-4"></i>
          <span>รีเซ็ตสถานะ</span>
        </button>
      </div>
    </div>
  </header>

  <main class="mx-auto max-w-7xl space-y-5 px-4 py-5 sm:px-6">

    <!-- Asymmetric Bento KPI Grid (Control Center Bento Style) -->
    <section class="no-print grid grid-cols-2 gap-4 lg:grid-cols-12">
      <!-- Hero Yellow Bento Tile (4 cols) -->
      <div class="col-span-2 lg:col-span-4 cc-tile-yellow p-5 flex flex-col justify-between">
        <div class="flex items-start justify-between">
          <div>
            <span class="rounded-full bg-slate-900/10 px-2.5 py-0.5 text-[11px] font-bold text-slate-900">ภาพรวมตำบลยางสว่าง (11 หมู่บ้าน)</span>
            <div class="mt-2 font-heading text-3xl font-bold text-slate-950">56 <span class="text-sm font-semibold text-slate-800">ราย</span></div>
          </div>
          <span class="cc-circle-btn flex h-11 w-11 items-center justify-center rounded-full bg-blue-600 text-white"><i data-lucide="users" class="h-5 w-5"></i></span>
        </div>
        <div class="mt-4 pt-3 border-t border-slate-900/10">
          <div class="flex items-center justify-between text-xs font-bold text-slate-900">
            <span>ความคืบหน้าลง 3C Plus+</span>
            <span id="kpiDoneCount">0 / 56</span>
          </div>
          <div class="mt-1.5 h-2.5 w-full overflow-hidden rounded-full bg-white/70">
            <div id="kpiDoneBar" class="h-full rounded-full bg-blue-600 transition-all" style="width: 0%"></div>
          </div>
        </div>
      </div>

      <!-- ติดบ้าน Cobalt Blue Bento Tile (2 cols) -->
      <div class="lg:col-span-2 cc-tile-blue p-4 flex flex-col justify-between">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold text-blue-100">กลุ่มติดบ้าน</span>
          <span class="cc-circle-btn flex h-9 w-9 items-center justify-center rounded-full bg-yellow-400 text-slate-950"><i data-lucide="home" class="h-4 w-4"></i></span>
        </div>
        <div class="mt-2 font-heading text-2xl font-bold text-white">43 <span class="text-xs font-normal text-blue-100">ราย</span></div>
        <div class="mt-1 text-[11px] font-medium text-blue-100">76.8% • TAI (B3–B5)</div>
      </div>

      <!-- ติดเตียง Crimson Red Bento Tile (2 cols) -->
      <div class="lg:col-span-2 cc-tile-red p-4 flex flex-col justify-between">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold text-red-100">กลุ่มติดเตียง</span>
          <span class="cc-circle-btn flex h-9 w-9 items-center justify-center rounded-full bg-yellow-400 text-slate-950"><i data-lucide="bed" class="h-4 w-4"></i></span>
        </div>
        <div class="mt-2 font-heading text-2xl font-bold text-white">13 <span class="text-xs font-normal text-red-100">ราย</span></div>
        <div class="mt-1 text-[11px] font-medium text-red-100">23.2% • TAI (I1–I3)</div>
      </div>

      <!-- CG Cool Slate Bento Tile (2 cols) -->
      <div class="lg:col-span-2 cc-tile-slate p-4 flex flex-col justify-between">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold text-slate-700">CG ในระบบ</span>
          <span class="cc-circle-btn flex h-9 w-9 items-center justify-center rounded-full bg-red-600 text-white"><i data-lucide="user-check" class="h-4 w-4"></i></span>
        </div>
        <div class="mt-2 font-heading text-2xl font-bold text-slate-950">15 <span class="text-xs font-normal text-slate-600">คน</span></div>
        <div class="mt-1 text-[11px] font-semibold text-red-700">4 หมู่บ้านรอจัดสรร CG</div>
      </div>

      <!-- ADL Avg Cool Slate Bento Tile (2 cols) -->
      <div class="col-span-2 lg:col-span-2 cc-tile-slate p-4 flex flex-col justify-between">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold text-slate-700">ADL เฉลี่ย</span>
          <span class="cc-circle-btn flex h-9 w-9 items-center justify-center rounded-full bg-blue-600 text-white"><i data-lucide="activity" class="h-4 w-4"></i></span>
        </div>
        <div class="mt-2 font-heading text-2xl font-bold text-slate-950">8.30</div>
        <div class="mt-1 text-[11px] font-semibold text-emerald-700">พิกัด GPS ครบ 56/56</div>
      </div>
    </section>

    <!-- Navigation Tabs -->
    <nav class="no-print flex flex-wrap gap-3">
      <button id="navTable" type="button" class="tab-active inline-flex items-center gap-2 rounded-2xl px-4 py-2.5 text-sm font-bold transition">
        <i data-lucide="table-2" class="h-4 w-4"></i>
        <span>ตารางลงข้อมูล 3C Plus+ (2 ส่วน)</span>
      </button>
      <button id="navCg" type="button" class="tab-inactive inline-flex items-center gap-2 rounded-2xl px-4 py-2.5 text-sm font-bold hover:bg-slate-200 transition">
        <i data-lucide="users-round" class="h-4 w-4"></i>
        <span>ทะเบียน CG (15 ราย) &amp; ภาระงาน</span>
      </button>
      <button id="navMap" type="button" class="tab-inactive inline-flex items-center gap-2 rounded-2xl px-4 py-2.5 text-sm font-bold hover:bg-slate-200 transition">
        <i data-lucide="map-pinned" class="h-4 w-4"></i>
        <span>แผนที่พิกัด GPS &amp; วิเคราะห์เชิงพื้นที่</span>
      </button>
      <button id="navScanner" type="button" class="tab-inactive inline-flex items-center gap-2 rounded-2xl px-4 py-2.5 text-sm font-bold hover:bg-slate-200 transition">
        <i data-lucide="scan-line" class="h-4 w-4"></i>
        <span>สแกนแบบประเมิน ADL (AI)</span>
      </button>
    </nav>

    <!-- TAB 1: 3C Plus+ 2-Part Table -->
    <section id="panelTable" class="space-y-4">
      <!-- Filter Bar -->
      <div class="bento-card p-4">
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-5">
          <div class="relative">
            <i data-lucide="search" class="pointer-events-none absolute left-3 top-2.5 h-4 w-4 text-slate-400"></i>
            <input id="searchInput" type="text" placeholder="ค้นหา ชื่อ, รหัส YSC, เลขบัตร, บ้านเลขที่..." class="w-full rounded-xl border border-slate-200 bg-slate-50 py-2 pl-9 pr-3 text-sm focus:border-teal-500 focus:bg-white focus:outline-none" />
          </div>
          <select id="filterMoo" class="rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-sm focus:border-teal-500 focus:bg-white focus:outline-none">
            <option value="ALL">ทุกหมู่บ้าน (ม.1 – ม.11)</option>
          </select>
          <select id="filterStatus" class="rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-sm focus:border-teal-500 focus:bg-white focus:outline-none">
            <option value="ALL">ทุกสถานะ (56 ราย)</option>
            <option value="ติดเตียง">ติดเตียง (13 ราย • ADL 0–4)</option>
            <option value="ติดบ้าน">ติดบ้าน (43 ราย • ADL 5–11)</option>
          </select>
          <select id="filterCg" class="rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-sm focus:border-teal-500 focus:bg-white focus:outline-none">
            <option value="ALL">CG ทุกคน (15 ราย + รอจัดสรร)</option>
            <option value="UNASSIGNED">ยังไม่ระบุ CG ประจำหมู่</option>
          </select>
          <select id="filterDone" class="rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-sm focus:border-teal-500 focus:bg-white focus:outline-none">
            <option value="ALL">สถานะลง 3C+: ทั้งหมด</option>
            <option value="PENDING">รอดำเนินการ</option>
            <option value="DONE">บันทึกแล้ว</option>
          </select>
        </div>
        <div class="mt-3 flex flex-wrap items-center justify-between gap-2 border-t border-slate-100 pt-3 text-xs text-slate-500">
          <div id="resultCounter">แสดง 56 จาก 56 รายการ</div>
          <div class="flex flex-wrap items-center gap-3">
            <span class="inline-flex items-center gap-1"><span class="h-2.5 w-2.5 rounded-full bg-rose-500"></span> ติดเตียง (ADL 0–4)</span>
            <span class="inline-flex items-center gap-1"><span class="h-2.5 w-2.5 rounded-full bg-sky-500"></span> ติดบ้าน (ADL 5–11)</span>
            <span class="inline-flex items-center gap-1 text-teal-700 font-medium"><i data-lucide="mouse-pointer-click" class="h-3.5 w-3.5"></i> คลิกปุ่มคัดลอกเพื่อวางลง 3C Plus+ ได้ทันที</span>
          </div>
        </div>
      </div>

      <!-- Main Table -->
      <div class="bento-card overflow-hidden">
        <div class="overflow-x-auto scrollbar-thin">
          <table class="w-full min-w-[1180px] border-collapse text-left text-xs sm:text-sm">
            <thead>
              <tr class="border-b border-slate-200 bg-slate-50/90 text-xs font-semibold uppercase tracking-wide text-slate-600">
                <th class="px-3 py-3 text-center w-12">ลงแล้ว</th>
                <th class="px-3 py-3 w-48">ผู้มีภาวะพึ่งพิง / ที่อยู่</th>
                <th class="px-3 py-3 w-44">เลขบัตร 13 หลัก &amp; GPS</th>
                <th class="px-3 py-3 w-52">CG ผู้รับผิดชอบ (ปรับได้)</th>
                <th class="px-3 py-3">ส่วนที่ 1: เสนอของบประมาณ (3C Plus+)</th>
                <th class="px-3 py-3">ส่วนที่ 2: แผนปฏิบัติงานจริง (3C Plus+)</th>
                <th class="px-3 py-3 text-center w-28">การ์ดลอก</th>
              </tr>
            </thead>
            <tbody id="patientTableBody" class="divide-y divide-slate-100"></tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- TAB 2: CG Roster & Workload -->
    <section id="panelCg" class="hidden space-y-4">
      <div class="bento-card border-amber-200 bg-amber-50/70 p-4">
        <div class="flex items-start gap-3">
          <i data-lucide="alert-triangle" class="mt-0.5 h-5 w-5 shrink-0 text-amber-600"></i>
          <div class="text-sm text-amber-900">
            <p class="font-semibold">สรุปความครอบคลุมพื้นที่ของ Caregiver (CG 15 ราย เทียบกับ 11 หมู่บ้าน):</p>
            <ul class="mt-1 list-disc space-y-0.5 pl-5 text-xs sm:text-sm">
              <li><strong>หมู่บ้านที่ยังไม่มี CG ประจำในรายชื่อ:</strong> ม.2 บ้านนางเข็ม (7 ราย / ติดเตียง 2), ม.5 บ้านน้อยพัฒนา (1 ราย), ม.8 บ้านโนนสังข์ (2 ราย), ม.11 บ้านหนองบัวศรีสว่าง (3 ราย / ติดเตียง 1)</li>
              <li><strong>หมู่บ้านภาระงานสูง:</strong> ม.7 บ้านขะยูง มีผู้ป่วย 12+1 ราย (ติดเตียง 5 ราย) ต่อ CG 2 คน และ ม.9 บ้านหนองตาด มี 6 ราย (ติดเตียง 3 ราย) ต่อ CG 1 คน</li>
              <li><strong>ข้อมูล CG รอเติม:</strong> ลำดับที่ 10 <strong>นางรุ่งนภา จันทพันธ์</strong> ยังไม่มีข้อมูลหมู่บ้าน/เลขบัตรในไฟล์ PDF — แนะนำให้ CM มอบหมายช่วยพื้นที่ ม.2 หรือ ม.7</li>
            </ul>
