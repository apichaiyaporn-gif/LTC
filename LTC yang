  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@400;500;600;700&family=Sarabun:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <script src="https://cdn.tailwindcss.com/3.4.17"></script>
  <script src="https://unpkg.com/lucide@0.460.0/dist/umd/lucide.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <style>
    body {
      font-family: 'Sarabun', sans-serif;
      background: radial-gradient(circle at 20% 10%, #1E293B 0%, #0F172A 50%, #172554 100%);
      color: #0F172A;
    }
    h1, h2, h3, .font-heading { font-family: 'Prompt', sans-serif; }
    .bento-card {
      background: rgba(255, 255, 255, 0.96);
      border: 1px solid rgba(255, 255, 255, 0.35);
      border-radius: 1.75rem;
      box-shadow: 0 12px 32px -8px rgba(2, 6, 23, 0.35), 0 2px 6px rgba(2, 6, 23, 0.12);
    }
    .cc-tile-yellow {
      background: linear-gradient(145deg, #FDE047 0%, #FACC15 100%);
      border: 1px solid rgba(255, 255, 255, 0.4);
      border-radius: 1.75rem;
      box-shadow: 0 12px 28px -6px rgba(250, 204, 21, 0.28);
      color: #0F172A;
    }
    .cc-tile-red {
      background: linear-gradient(145deg, #EF4444 0%, #DC2626 100%);
      border: 1px solid rgba(255, 255, 255, 0.22);
      border-radius: 1.75rem;
      box-shadow: 0 12px 28px -6px rgba(220, 38, 38, 0.32);
      color: #FFFFFF;
    }
    .cc-tile-blue {
      background: linear-gradient(145deg, #3B82F6 0%, #2563EB 100%);
      border: 1px solid rgba(255, 255, 255, 0.22);
      border-radius: 1.75rem;
      box-shadow: 0 12px 28px -6px rgba(37, 99, 235, 0.32);
      color: #FFFFFF;
    }
    .cc-tile-slate {
      background: linear-gradient(145deg, #E2E8F0 0%, #CBD5E1 100%);
      border: 1px solid rgba(255, 255, 255, 0.5);
      border-radius: 1.75rem;
      box-shadow: 0 12px 28px -6px rgba(15, 23, 42, 0.25);
      color: #0F172A;
    }
    .cc-circle-btn {
      box-shadow: 0 4px 12px rgba(2, 6, 23, 0.18);
      transition: transform 0.15s ease, filter 0.15s ease;
    }
    .cc-circle-btn:hover { transform: translateY(-1px); filter: brightness(1.04); }
    .copy-btn:active { transform: scale(0.96); }
    .tab-active {
      background: #FACC15;
      color: #0F172A;
      box-shadow: 0 8px 20px -4px rgba(250, 204, 21, 0.45);
    }
    .tab-inactive {
      background: rgba(226, 232, 240, 0.92);
      color: #0F172A;
      border: 1px solid rgba(255, 255, 255, 0.4);
    }
    .scrollbar-thin::-webkit-scrollbar { height: 8px; width: 8px; }
    .scrollbar-thin::-webkit-scrollbar-track { background: #E2E8F0; border-radius: 9999px; }
    .scrollbar-thin::-webkit-scrollbar-thumb { background: #64748B; border-radius: 9999px; }
    .scrollbar-thin::-webkit-scrollbar-thumb:hover { background: #475569; }
    @keyframes scanLine {
      0% { transform: translateY(0%); opacity: 0.2; }
      50% { opacity: 1; }
      100% { transform: translateY(100%); opacity: 0.2; }
    }
    .animate-scan-line { animation: scanLine 2.2s ease-in-out infinite alternate; }
    @media print {
      @page { size: A4 portrait; margin: 12mm 12mm 14mm 12mm; }
      body { background: #FFFFFF !important; color: #000000 !important; font-size: 12px !important; }
      .no-print { display: none !important; }
      .print-only { display: block !important; }
      .bento-card, .cc-tile-yellow, .cc-tile-blue, .cc-tile-red, .cc-tile-slate {
        box-shadow: none !important; border: 1px solid #CBD5E1 !important; background: #FFFFFF !important; color: #000000 !important;
      }
      .print-break-before { page-break-before: always; }
    }
  </style>
</head>
<body class="min-h-screen antialiased">

  <!-- Toast Notification -->
  <div id="toast" class="fixed bottom-5 right-5 z-50 hidden items-center gap-2.5 rounded-2xl bg-slate-900 px-4 py-3 text-sm font-medium text-white shadow-xl transition-all">
    <i data-lucide="check-circle-2" class="h-4 w-4 text-emerald-400"></i>
    <span id="toastText">คัดลอกข้อมูลแล้ว</span>
