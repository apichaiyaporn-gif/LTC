    function buildClinicalAlerts(data, total) {
      const alerts = [];
      if (data.aiNotes) alerts.push(`<strong>ข้อสังเกต:</strong> ${escHtml(data.aiNotes)}`);
      if (total <= 4) alerts.push('<strong>ยืนยันกลุ่ม LTC (กลุ่ม 3 vs 4):</strong> ADL 0–4 คะแนน กรุณายืนยันผล TAI และภาวะแทรกซ้อนก่อนบันทึก');
      if (data.adl.bladder === 0 && data.bladderMode === 'unconfirmed_incontinence') alerts.push('<strong>ยืนยันข้อ 10 (Bladder = 0):</strong> ตรวจสอบหน้างานว่ากลั้นไม่ได้หรือคาสายสวน Foley\'s Cath');
      const missing = [];
      if (!data.cid) missing.push('เลขบัตร 13 หลัก');
      if (!data.healthRight) missing.push('สิทธิการรักษา');
      if (!data.gps) missing.push('พิกัด GPS');
      if (missing.length) alerts.push(`<strong>ข้อมูลที่ต้องเติมเพิ่ม:</strong> ${missing.join(', ')}`);
      return alerts.length ? alerts : ['ข้อมูลครบถ้วนพร้อมบันทึกเข้าสู่ 3C Plus+ แล้ว'];
    }

